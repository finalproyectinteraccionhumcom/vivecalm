<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_tarjeta"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvFechaEntrada"
        style="@style/TextoEtiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/verde" />

    <TextView
        android:id="@+id/tvPreguntaEntrada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/texto"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTextoEntrada"
        style="@style/TextoNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="4" />

    <TextView
        android:id="@+id/tvGratitudEntrada"
        style="@style/TextoSecundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />
</LinearLayout>
