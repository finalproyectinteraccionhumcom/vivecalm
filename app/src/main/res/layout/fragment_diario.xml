<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvFechaDiario"
            style="@style/TextoSecundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            style="@style/TextoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi diario" />

        <!-- emoción de hoy -->
        <LinearLayout
            android:id="@+id/filaEmocionHoy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_etiqueta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/ivEmocionHoy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvEmocionHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/verde_oscuro"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- pregunta del día -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tarjeta"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pregunta del día"
                android:textColor="@color/azul" />

            <TextView
                android:id="@+id/tvPregunta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:labelFor="@+id/etEntrada"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_buscador"
                android:gravity="top|start"
                android:hint="Escribe con calma, nadie más lo va a leer…"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5"
                android:padding="14dp"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_secundario"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvPalabras"
                style="@style/TextoSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:text="0 palabras" />
        </LinearLayout>

        <!-- agradecimientos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tarjeta_amarilla"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/TextoSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoy agradezco…" />

            <EditText
                android:id="@+id/etGratitud1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_buscador"
                android:hint="1. Algo pequeño también cuenta"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_secundario"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etGratitud2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_buscador"
                android:hint="2. Una persona"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_secundario"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etGratitud3"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_buscador"
                android:hint="3. Un momento"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_secundario"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarDiario"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Guardar entrada" />

        <!-- entradas anteriores -->
        <TextView
            style="@style/TextoSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Entradas anteriores" />

        <TextView
            android:id="@+id/tvSinEntradas"
            style="@style/TextoSecundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Todavía no tienes entradas. ¡Hoy es buen día para empezar!" />

        <LinearLayout
            android:id="@+id/contenedorEntradas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
